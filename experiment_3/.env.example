# ── LLM Provider ─────────────────────────────────────────────────
# "openai" uses GPT-4o-mini (requires API key below)
# "local"  uses google/flan-t5-base (runs on CPU, no key needed)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
LOCAL_LLM_MODEL=google/flan-t5-base

# ── OCR ──────────────────────────────────────────────────────────
TESSERACT_CMD=tesseract
TESSERACT_LANG=eng
TESSERACT_PSM=6
TROCR_MODEL=microsoft/trocr-base-handwritten
USE_TROCR=true

# ── Embeddings ───────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Text Chunking ────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# ── RAG ──────────────────────────────────────────────────────────
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
